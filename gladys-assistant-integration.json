{
  "manifest_version": 1,
  "type": "device",
  "name": "Synology DSM",
  "description": {
    "en": "Monitor Synology NAS system metrics, storage volumes, disk SMART health and backups.",
    "fr": "Supervisez les métriques système, volumes, états SMART des disques et sauvegardes d'un NAS Synology."
  },
  "version": "1.0.4",
  "docker_image": "ghcr.io/prohand/gladys-synology:1.0.4",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/prohand/gladys-synology/main/cover.png",
  "categories": ["network"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Synology DSM connection",
        "fr": "Connexion à Synology DSM"
      },
      "description": {
        "en": "Use a dedicated, read-only DSM account. Gladys must be able to reach the NAS on your local network.",
        "fr": "Utilisez un compte DSM dédié en lecture seule. Gladys doit pouvoir joindre le NAS sur votre réseau local."
      },
      "links": [
        {
          "url": "https://github.com/prohand/gladys-synology/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation"
          }
        }
      ]
    },
    {
      "key": "url",
      "type": "string",
      "label": {
        "en": "DSM URL",
        "fr": "URL DSM"
      },
      "description": {
        "en": "For example: https://192.168.1.20:5001",
        "fr": "Par exemple : https://192.168.1.20:5001"
      },
      "required": true
    },
    {
      "key": "username",
      "type": "string",
      "label": {
        "en": "Username",
        "fr": "Nom d'utilisateur"
      },
      "required": true
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "Password",
        "fr": "Mot de passe"
      },
      "required": true
    },
    {
      "key": "otp_code",
      "type": "secret",
      "label": {
        "en": "Current OTP code (MFA)",
        "fr": "Code OTP actuel (MFA)"
      },
      "description": {
        "en": "Required only to trust this Gladys installation on the first MFA login, or after revoking the trusted device in DSM. Enter a current 6-digit verification code.",
        "fr": "Requis uniquement pour approuver cette installation Gladys lors de la première connexion MFA, ou après révocation de l'appareil de confiance dans DSM. Saisissez un code de vérification actuel à 6 chiffres."
      },
      "required": false
    },
    {
      "key": "verify_ssl",
      "type": "boolean",
      "label": {
        "en": "Verify the TLS certificate",
        "fr": "Vérifier le certificat TLS"
      },
      "description": {
        "en": "Keep enabled unless DSM uses a self-signed certificate.",
        "fr": "Laissez activé sauf si DSM utilise un certificat auto-signé."
      },
      "required": false,
      "default": true
    },
    {
      "key": "nas_2_section",
      "type": "section",
      "label": {
        "en": "NAS 2 (optional)",
        "fr": "NAS 2 (facultatif)"
      },
      "description": {
        "en": "Leave the URL empty to ignore this slot. Credentials are stored in dedicated secret fields.",
        "fr": "Laissez l'URL vide pour ignorer cet emplacement. Les identifiants sont stockés dans des champs secrets dédiés."
      }
    },
    {
      "key": "nas_2_url",
      "type": "string",
      "label": {
        "en": "NAS 2 — DSM URL",
        "fr": "NAS 2 — URL DSM"
      },
      "required": false
    },
    {
      "key": "nas_2_username",
      "type": "string",
      "label": {
        "en": "NAS 2 — Username",
        "fr": "NAS 2 — Nom d'utilisateur"
      },
      "required": false
    },
    {
      "key": "nas_2_password",
      "type": "secret",
      "label": {
        "en": "NAS 2 — Password",
        "fr": "NAS 2 — Mot de passe"
      },
      "required": false
    },
    {
      "key": "nas_2_otp_code",
      "type": "secret",
      "label": {
        "en": "NAS 2 — Current OTP code",
        "fr": "NAS 2 — Code OTP actuel"
      },
      "required": false
    },
    {
      "key": "nas_2_verify_ssl",
      "type": "boolean",
      "label": {
        "en": "NAS 2 — Verify TLS certificate",
        "fr": "NAS 2 — Vérifier le certificat TLS"
      },
      "required": false,
      "default": true
    },
    {
      "key": "nas_3_section",
      "type": "section",
      "label": {
        "en": "NAS 3 (optional)",
        "fr": "NAS 3 (facultatif)"
      },
      "description": {
        "en": "Leave the URL empty to ignore this slot. Credentials are stored in dedicated secret fields.",
        "fr": "Laissez l'URL vide pour ignorer cet emplacement. Les identifiants sont stockés dans des champs secrets dédiés."
      }
    },
    {
      "key": "nas_3_url",
      "type": "string",
      "label": {
        "en": "NAS 3 — DSM URL",
        "fr": "NAS 3 — URL DSM"
      },
      "required": false
    },
    {
      "key": "nas_3_username",
      "type": "string",
      "label": {
        "en": "NAS 3 — Username",
        "fr": "NAS 3 — Nom d'utilisateur"
      },
      "required": false
    },
    {
      "key": "nas_3_password",
      "type": "secret",
      "label": {
        "en": "NAS 3 — Password",
        "fr": "NAS 3 — Mot de passe"
      },
      "required": false
    },
    {
      "key": "nas_3_otp_code",
      "type": "secret",
      "label": {
        "en": "NAS 3 — Current OTP code",
        "fr": "NAS 3 — Code OTP actuel"
      },
      "required": false
    },
    {
      "key": "nas_3_verify_ssl",
      "type": "boolean",
      "label": {
        "en": "NAS 3 — Verify TLS certificate",
        "fr": "NAS 3 — Vérifier le certificat TLS"
      },
      "required": false,
      "default": true
    },
    {
      "key": "nas_4_section",
      "type": "section",
      "label": {
        "en": "NAS 4 (optional)",
        "fr": "NAS 4 (facultatif)"
      },
      "description": {
        "en": "Leave the URL empty to ignore this slot. Credentials are stored in dedicated secret fields.",
        "fr": "Laissez l'URL vide pour ignorer cet emplacement. Les identifiants sont stockés dans des champs secrets dédiés."
      }
    },
    {
      "key": "nas_4_url",
      "type": "string",
      "label": {
        "en": "NAS 4 — DSM URL",
        "fr": "NAS 4 — URL DSM"
      },
      "required": false
    },
    {
      "key": "nas_4_username",
      "type": "string",
      "label": {
        "en": "NAS 4 — Username",
        "fr": "NAS 4 — Nom d'utilisateur"
      },
      "required": false
    },
    {
      "key": "nas_4_password",
      "type": "secret",
      "label": {
        "en": "NAS 4 — Password",
        "fr": "NAS 4 — Mot de passe"
      },
      "required": false
    },
    {
      "key": "nas_4_otp_code",
      "type": "secret",
      "label": {
        "en": "NAS 4 — Current OTP code",
        "fr": "NAS 4 — Code OTP actuel"
      },
      "required": false
    },
    {
      "key": "nas_4_verify_ssl",
      "type": "boolean",
      "label": {
        "en": "NAS 4 — Verify TLS certificate",
        "fr": "NAS 4 — Vérifier le certificat TLS"
      },
      "required": false,
      "default": true
    },
    {
      "key": "poll_frequency",
      "type": "number",
      "label": {
        "en": "Refresh interval (s)",
        "fr": "Intervalle de rafraîchissement (s)"
      },
      "description": {
        "en": "Custom interval in seconds (60 to 86400). The default is 900 seconds. A moderate interval limits the growth of the Gladys database.",
        "fr": "Intervalle personnalisé en secondes (60 à 86400). La valeur par défaut est 900 secondes. Un intervalle modéré limite la croissance de la base Gladys."
      },
      "required": false,
      "default": 900,
      "min": 60,
      "max": 86400,
      "placeholder": {
        "en": "900",
        "fr": "900"
      }
    },
    {
      "key": "date_format",
      "type": "select",
      "label": {
        "en": "Date format",
        "fr": "Format de date"
      },
      "description": {
        "en": "Format used for the backup dates published to Gladys. Every format except ISO 8601 shows the local time of the integration container.",
        "fr": "Format utilisé pour les dates de sauvegarde publiées dans Gladys. Tous les formats sauf ISO 8601 affichent l'heure locale du conteneur de l'intégration."
      },
      "required": false,
      "default": "iso",
      "options": [
        {
          "value": "iso",
          "label": {
            "en": "ISO 8601 (UTC) — 2026-08-20T13:08:00.000Z",
            "fr": "ISO 8601 (UTC) — 2026-08-20T13:08:00.000Z"
          }
        },
        {
          "value": "iso_local",
          "label": {
            "en": "YYYY-MM-DD HH:mm — 2026-08-20 15:08",
            "fr": "AAAA-MM-JJ HH:mm — 2026-08-20 15:08"
          }
        },
        {
          "value": "european",
          "label": {
            "en": "DD/MM/YYYY HH:mm — 20/08/2026 15:08",
            "fr": "JJ/MM/AAAA HH:mm — 20/08/2026 15:08"
          }
        },
        {
          "value": "us",
          "label": {
            "en": "MM/DD/YYYY hh:mm AM/PM — 08/20/2026 03:08 PM",
            "fr": "MM/JJ/AAAA hh:mm AM/PM — 08/20/2026 03:08 PM"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the DSM connection",
        "fr": "Tester la connexion DSM"
      },
      "timeout_seconds": 30
    }
  ],
  "widgets": [
    {
      "key": "nas_overview",
      "label": {
        "en": "Synology NAS",
        "fr": "NAS Synology"
      },
      "description": {
        "en": "Load, temperature, volumes, disks and backups of one NAS, with the load history.",
        "fr": "Charge, température, volumes, disques et sauvegardes d'un NAS, avec l'historique de la charge."
      },
      "icon": "server",
      "settings": [
        {
          "key": "nas",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "NAS",
            "fr": "NAS"
          },
          "description": {
            "en": "Any device of the NAS to show. Leave empty for the first NAS.",
            "fr": "N'importe quel appareil du NAS à afficher. Laissez vide pour le premier NAS."
          },
          "required": false
        },
        {
          "key": "chart_interval",
          "type": "select",
          "label": {
            "en": "Load history",
            "fr": "Historique de la charge"
          },
          "description": {
            "en": "Shown once the NAS device is added to Gladys.",
            "fr": "Affiché une fois l'appareil NAS ajouté à Gladys."
          },
          "options": [
            {
              "value": "last-day",
              "label": {
                "en": "Last 24 hours",
                "fr": "Dernières 24 heures"
              }
            },
            {
              "value": "last-three-days",
              "label": {
                "en": "Last 3 days",
                "fr": "3 derniers jours"
              }
            },
            {
              "value": "last-week",
              "label": {
                "en": "Last week",
                "fr": "Dernière semaine"
              }
            },
            {
              "value": "last-month",
              "label": {
                "en": "Last month",
                "fr": "Dernier mois"
              }
            }
          ],
          "required": false,
          "default": "last-day"
        }
      ]
    },
    {
      "key": "storage",
      "label": {
        "en": "Synology storage",
        "fr": "Stockage Synology"
      },
      "description": {
        "en": "Usage of each volume, free space, SMART status and temperature of each disk.",
        "fr": "Occupation de chaque volume, espace libre, état SMART et température de chaque disque."
      },
      "icon": "hard-drive",
      "settings": [
        {
          "key": "nas",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "NAS",
            "fr": "NAS"
          },
          "description": {
            "en": "Any device of the NAS to show. Leave empty for the first NAS.",
            "fr": "N'importe quel appareil du NAS à afficher. Laissez vide pour le premier NAS."
          },
          "required": false
        }
      ]
    },
    {
      "key": "backups",
      "label": {
        "en": "Synology backups",
        "fr": "Sauvegardes Synology"
      },
      "description": {
        "en": "Hyper Backup and Active Backup tasks with their last result, failures first.",
        "fr": "Tâches Hyper Backup et Active Backup avec leur dernier résultat, échecs en premier."
      },
      "icon": "archive",
      "settings": [
        {
          "key": "nas",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "NAS",
            "fr": "NAS"
          },
          "description": {
            "en": "Any device of the NAS to show. Leave empty to show every NAS.",
            "fr": "N'importe quel appareil du NAS à afficher. Laissez vide pour afficher tous les NAS."
          },
          "required": false
        },
        {
          "key": "tasks",
          "type": "select",
          "label": {
            "en": "Tasks shown",
            "fr": "Tâches affichées"
          },
          "options": [
            {
              "value": "all",
              "label": {
                "en": "All tasks",
                "fr": "Toutes les tâches"
              }
            },
            {
              "value": "problems",
              "label": {
                "en": "Failed or partial only",
                "fr": "En échec ou partielles uniquement"
              }
            }
          ],
          "required": false,
          "default": "all"
        }
      ]
    }
  ],
  "scene_triggers": [
    {
      "key": "nas_unreachable",
      "label": {
        "en": "A Synology NAS stops answering",
        "fr": "Un NAS Synology ne répond plus"
      },
      "description": {
        "en": "Fires once when a NAS that was answering fails a refresh.",
        "fr": "Se déclenche une fois quand un NAS qui répondait échoue à un rafraîchissement."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "NAS",
            "fr": "NAS"
          },
          "description": {
            "en": "Choose the NAS device. Leave empty for any NAS.",
            "fr": "Choisissez l'appareil NAS. Laissez vide pour n'importe quel NAS."
          },
          "required": false
        }
      ],
      "variables": [
        {
          "key": "nas_name",
          "type": "string",
          "label": {
            "en": "NAS model",
            "fr": "Modèle du NAS"
          }
        },
        {
          "key": "url",
          "type": "string",
          "label": {
            "en": "DSM URL",
            "fr": "URL DSM"
          }
        },
        {
          "key": "error",
          "type": "string",
          "label": {
            "en": "Error",
            "fr": "Erreur"
          }
        }
      ]
    },
    {
      "key": "nas_reachable",
      "label": {
        "en": "A Synology NAS answers again",
        "fr": "Un NAS Synology répond à nouveau"
      },
      "description": {
        "en": "Fires once when a NAS reported unreachable answers again.",
        "fr": "Se déclenche une fois quand un NAS signalé injoignable répond à nouveau."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "NAS",
            "fr": "NAS"
          },
          "description": {
            "en": "Choose the NAS device. Leave empty for any NAS.",
            "fr": "Choisissez l'appareil NAS. Laissez vide pour n'importe quel NAS."
          },
          "required": false
        }
      ],
      "variables": [
        {
          "key": "nas_name",
          "type": "string",
          "label": {
            "en": "NAS model",
            "fr": "Modèle du NAS"
          }
        },
        {
          "key": "url",
          "type": "string",
          "label": {
            "en": "DSM URL",
            "fr": "URL DSM"
          }
        },
        {
          "key": "offline_minutes",
          "type": "number",
          "label": {
            "en": "Unreachable for (min)",
            "fr": "Injoignable pendant (min)"
          }
        }
      ]
    },
    {
      "key": "volume_unhealthy",
      "label": {
        "en": "A Synology volume is degraded",
        "fr": "Un volume Synology est dégradé"
      },
      "description": {
        "en": "Fires once when DSM reports a healthy volume as degraded, crashed or in error.",
        "fr": "Se déclenche une fois quand DSM signale un volume sain comme dégradé, planté ou en erreur."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Volume",
            "fr": "Volume"
          },
          "description": {
            "en": "Choose a volume. Leave empty for any volume.",
            "fr": "Choisissez un volume. Laissez vide pour n'importe quel volume."
          },
          "required": false
        }
      ],
      "variables": [
        {
          "key": "nas_name",
          "type": "string",
          "label": {
            "en": "NAS model",
            "fr": "Modèle du NAS"
          }
        },
        {
          "key": "volume_name",
          "type": "string",
          "label": {
            "en": "Volume name",
            "fr": "Nom du volume"
          }
        },
        {
          "key": "status",
          "type": "string",
          "label": {
            "en": "DSM status",
            "fr": "État DSM"
          }
        },
        {
          "key": "usage_percent",
          "type": "number",
          "label": {
            "en": "Usage (%)",
            "fr": "Occupation (%)"
          }
        }
      ]
    },
    {
      "key": "disk_unhealthy",
      "label": {
        "en": "A Synology disk is failing",
        "fr": "Un disque Synology est défaillant"
      },
      "description": {
        "en": "Fires once when the SMART status of a healthy disk turns to a failure.",
        "fr": "Se déclenche une fois quand l'état SMART d'un disque sain passe en défaut."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Disk",
            "fr": "Disque"
          },
          "description": {
            "en": "Choose a disk. Leave empty for any disk.",
            "fr": "Choisissez un disque. Laissez vide pour n'importe quel disque."
          },
          "required": false
        }
      ],
      "variables": [
        {
          "key": "nas_name",
          "type": "string",
          "label": {
            "en": "NAS model",
            "fr": "Modèle du NAS"
          }
        },
        {
          "key": "disk_name",
          "type": "string",
          "label": {
            "en": "Disk name",
            "fr": "Nom du disque"
          }
        },
        {
          "key": "smart_status",
          "type": "string",
          "label": {
            "en": "SMART status",
            "fr": "État SMART"
          }
        },
        {
          "key": "temperature",
          "type": "number",
          "label": {
            "en": "Temperature (°C)",
            "fr": "Température (°C)"
          }
        }
      ]
    },
    {
      "key": "backup_finished",
      "label": {
        "en": "A Synology backup finished",
        "fr": "Une sauvegarde Synology est terminée"
      },
      "description": {
        "en": "Fires once per backup run, when a new result is read from Hyper Backup or Active Backup.",
        "fr": "Se déclenche une fois par sauvegarde, quand un nouveau résultat est lu dans Hyper Backup ou Active Backup."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Backup task",
            "fr": "Tâche de sauvegarde"
          },
          "description": {
            "en": "Choose a backup task. Leave empty for any task.",
            "fr": "Choisissez une tâche de sauvegarde. Laissez vide pour n'importe quelle tâche."
          },
          "required": false
        },
        {
          "key": "provider",
          "type": "select",
          "label": {
            "en": "Package",
            "fr": "Paquet"
          },
          "description": {
            "en": "Leave empty for both.",
            "fr": "Laissez vide pour les deux."
          },
          "options": [
            {
              "value": "hyper-backup",
              "label": {
                "en": "Hyper Backup",
                "fr": "Hyper Backup"
              }
            },
            {
              "value": "active-backup",
              "label": {
                "en": "Active Backup",
                "fr": "Active Backup"
              }
            }
          ],
          "required": false
        },
        {
          "key": "outcome",
          "type": "multi_select",
          "label": {
            "en": "Result",
            "fr": "Résultat"
          },
          "description": {
            "en": "Leave empty for any result.",
            "fr": "Laissez vide pour tous les résultats."
          },
          "options": [
            {
              "value": "success",
              "label": {
                "en": "Success",
                "fr": "Réussie"
              }
            },
            {
              "value": "partial",
              "label": {
                "en": "Partial success",
                "fr": "Réussite partielle"
              }
            },
            {
              "value": "failure",
              "label": {
                "en": "Failure or cancelled",
                "fr": "Échec ou annulée"
              }
            }
          ],
          "required": false
        }
      ],
      "variables": [
        {
          "key": "nas_name",
          "type": "string",
          "label": {
            "en": "NAS model",
            "fr": "Modèle du NAS"
          }
        },
        {
          "key": "task_name",
          "type": "string",
          "label": {
            "en": "Task name",
            "fr": "Nom de la tâche"
          }
        },
        {
          "key": "provider_name",
          "type": "string",
          "label": {
            "en": "Package",
            "fr": "Paquet"
          }
        },
        {
          "key": "result",
          "type": "string",
          "label": {
            "en": "Result reported by DSM",
            "fr": "Résultat renvoyé par DSM"
          }
        },
        {
          "key": "outcome",
          "type": "string",
          "label": {
            "en": "Result (success, partial or failure)",
            "fr": "Résultat (success, partial ou failure)"
          }
        },
        {
          "key": "last_backup",
          "type": "string",
          "label": {
            "en": "Backup date",
            "fr": "Date de la sauvegarde"
          }
        }
      ]
    },
    {
      "key": "dsm_updated",
      "label": {
